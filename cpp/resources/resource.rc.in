#include <windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/resources/resource.h"

IDI_KEYBOARD_ICON ICON "@KEYBOARD_ICO_PATH@"

// ── Embedded version / publisher metadata ──────────────────
// Visible in Explorer → Right-click → Properties → Details.
// Helps Windows Defender / SmartScreen trust the binary.
VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0x0
    FILEOS         VOS__WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "KeyboardSwitcher\0"
            VALUE "FileDescription",  "Automatic Keyboard Language Switcher (En/He/Ru)\0"
            VALUE "FileVersion",      "@PROJECT_VERSION@\0"
            VALUE "InternalName",     "KeyboardSwitcher\0"
            VALUE "LegalCopyright",   "Copyright (C) 2025-2026 KeyboardSwitcher\0"
            VALUE "OriginalFilename", "KeyboardSwitcher.exe\0"
            VALUE "ProductName",      "Keyboard Switcher\0"
            VALUE "ProductVersion",   "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END



